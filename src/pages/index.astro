---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/site.css';

// Preloaded so the first layout already has the real fonts (no swap re-layout).
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import sansUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import sans500Url from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url';
import monoUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

import Tags from '../components/Tags.astro';
import MiniFlow from '../components/MiniFlow.astro';
import ThesisFlow from '../components/ThesisFlow.astro';
import { slug } from '../lib/slug';
import { site, contact, hero, work, experience, skills, education } from '../content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();

// A tag is "shared" (and therefore hoverable) when two or more rows use it.
const rows = [work.featured, ...work.projects, ...work.more.items, ...experience.entries];
const counts = new Map<string, number>();
for (const row of rows) for (const t of new Set(row.tags)) counts.set(t, (counts.get(t) ?? 0) + 1);
const shared = new Set([...counts].filter(([, n]) => n > 1).map(([t]) => t));
const tagAttr = (tags: string[]) => tags.map(slug).join(' ');

// Hero links. A placeholder value ("[...]") is printed without a link.
const isPlaceholder = (v: string) => v.startsWith('[');
const links = [
  { label: 'GitHub', href: contact.github, external: true, placeholder: isPlaceholder(contact.github) },
  { label: 'LinkedIn', href: contact.linkedin, external: true, placeholder: isPlaceholder(contact.linkedin) },
  { label: 'Email', href: `mailto:${contact.email}`, external: false, placeholder: isPlaceholder(contact.email) },
  { label: 'CV (PDF)', href: `${base}${contact.cv}`, external: false, placeholder: false },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f6f3ec" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="profile" />
    {[serifUrl, sansUrl, sans500Url, monoUrl].map((u) => <link rel="preload" as="font" type="font/woff2" href={u} crossorigin />)}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      // Runs before first paint: marks JS as available and applies the stored
      // (or system-preferred) theme so the page never flashes the wrong one.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#work">Skip to selected work</a>

    <header class="wrap">
      <div class="top">
        <a class="top-name" href={base}>{site.name}</a>
        <nav class="top-nav" aria-label="Sections">
          {site.nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="theme" role="group" aria-label="Colour theme">
          <button type="button" data-theme-set="light" aria-pressed="true">Light</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <!-- ============================== Hero ============================== -->
      <section class="hero grid">
        <div class="hero-text">
          <h1>{site.name.split(' ').map((part, i) => <>{i > 0 && <br />}{part}</>)}</h1>
          <p class="lede">{hero.sentence}</p>
          <p class="next">{hero.lookingFor}</p>
          <ul class="links">
            {links.map((l) => (
              <li>
                {l.placeholder
                  ? <span class="link-todo" title="Placeholder: set this in src/content.ts">{l.label}</span>
                  : <a href={l.href} rel={l.external ? 'me noopener' : undefined}>{l.label}</a>}
              </li>
            ))}
          </ul>
        </div>
        <div class="hero-fig" id="pipeline">
          <ThesisFlow />
        </div>
      </section>

      <!-- ========================== Selected work ========================= -->
      <section class="section" id="work" data-reveal>
        <h2>{work.heading}</h2>

        <article class="feature grid" data-tags={tagAttr(work.featured.tags)}>
          <div class="feature-head">
            <p class="eyebrow">{work.featured.org}</p>
            <h3>{work.featured.title}</h3>
            <p class="outcome">{work.featured.outcome}</p>
            <p class="meta">{work.featured.role}<br /><span class="dates">{work.featured.dates}</span></p>
            <Tags tags={work.featured.tags} shared={shared} />
          </div>
          <div class="feature-body">
            <dl class="details">
              {work.featured.details.map((d) => (
                <div>
                  <dt class="eyebrow">{d.label}</dt>
                  <dd>{d.text}</dd>
                </div>
              ))}
            </dl>
            <p class="up"><a href="#pipeline">{work.featured.diagramLink}</a></p>
          </div>
        </article>

        {work.projects.map((p, i) => (
          <article class="project grid" data-tags={tagAttr(p.tags)}>
            <div class="project-head">
              <h3>{p.title}</h3>
              <p class="meta">{p.role}<br /><span class="dates">{p.dates}</span></p>
            </div>
            <div class="project-body">
              <p class="outcome">{p.outcome}</p>
              <Tags tags={p.tags} shared={shared} />
            </div>
            <div class="project-fig">
              <MiniFlow stages={p.diagram} label={p.diagramLabel} seed={200 + i * 17} />
            </div>
          </article>
        ))}

        <div class="more">
          {work.more.items.map((m) => (
            <div class="more-row" data-tags={tagAttr(m.tags)}>
              <p class="eyebrow">{work.more.label}</p>
              <p class="more-text"><b>{m.title}</b>: {m.text} <span class="dates">{m.dates}</span></p>
              <Tags tags={m.tags} shared={shared} />
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== Experience =========================== -->
      <section class="section" id="experience" data-reveal>
        <h2>{experience.heading}</h2>
        <ol class="timeline">
          {experience.entries.map((e) => (
            <li class="grid" data-tags={tagAttr(e.tags)}>
              <p class="when"><span class="year">{e.year}</span><span class="dates">{e.dates}</span></p>
              <div class="what">
                <h3>{e.role}</h3>
                <p class="meta">{e.org}</p>
                <p>{e.text}</p>
                <Tags tags={e.tags} shared={shared} />
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ============================= Skills ============================= -->
      <section class="section" id="skills" data-reveal>
        <h2>{skills.heading}</h2>
        <dl class="skills">
          {skills.groups.map((g) => (
            <div class="grid">
              <dt class="eyebrow">{g.label}</dt>
              <dd>{g.text}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- ==================== Education & certificates ==================== -->
      <section class="section" id="education" data-reveal>
        <h2>{education.heading}</h2>
        <div class="grid edu">
          <div class="edu-a">
            <h3 class="eyebrow">{education.degreesLabel}</h3>
            <ul class="plain">
              {education.degrees.map((d) => (
                <li>
                  <b>{d.title}</b>
                  <span class="meta">{d.place} <span class="dates">{d.dates}</span></span>
                </li>
              ))}
            </ul>
          </div>
          <div class="edu-b">
            <h3 class="eyebrow">{education.certificatesLabel}</h3>
            <ul class="plain">
              {education.certificates.map((c) => (
                <li>
                  <b>{c.title}</b>
                  <span class="meta">{c.detail}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="edu-a">
            <h3 class="eyebrow">{education.activitiesLabel}</h3>
            <ul class="plain tight">
              {education.activities.map((a) => <li>{a}</li>)}
            </ul>
          </div>
          <div class="edu-b">
            <h3 class="eyebrow">{education.languagesLabel}</h3>
            <ul class="plain langs">
              {education.languages.map((l) => <li>{l.name} <span class="dates">{l.level}</span></li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ============================= Contact ============================ -->
      <section class="section contact" id="contact" data-reveal>
        <h2>{contact.heading}</h2>
        <p class="lede">{contact.sentence}</p>
        <p class="contact-mail">
          {isPlaceholder(contact.email)
            ? <span class="link-todo" title="Placeholder: set this in src/content.ts">{contact.email}</span>
            : <a href={`mailto:${contact.email}`}>{contact.email}</a>}
        </p>
      </section>
    </main>

    <footer class="wrap">
      <div class="foot">
        <p>© {year} {site.name}</p>
        <p><a href="#top">Back to top</a></p>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
