---
// Self-hosted fonts, only the styles in use; all load with font-display: swap.
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist/wght.css'; // one file covers 400, 500 and 600
import '@fontsource/geist-mono/400.css';
import '../styles/site.css';

// Preloaded so the first layout already has the real fonts (no swap re-layout).
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';

import Tags from '../components/Tags.astro';
import Ref from '../components/Ref.astro';
import ThesisFlow from '../components/ThesisFlow.astro';
import { slug } from '../lib/slug';
import { emph } from '../lib/emph';
import { isTodo, usable } from '../lib/todo';
import { site, contact, hero, work, experience, skills, education } from '../content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();

// A tag is "shared" (and therefore hoverable) when two or more rows use it.
const rows = [work.featured, ...work.projects, ...work.more.items, ...experience.entries];
const counts = new Map<string, number>();
for (const row of rows) for (const t of new Set(row.tags)) counts.set(t, (counts.get(t) ?? 0) + 1);
const shared = new Set([...counts].filter(([, n]) => n > 1).map(([t]) => t));
const tagAttr = (tags: string[]) => tags.map(slug).join(' ');

// Links whose address is still a TODO are dropped from the published build.
const live = <T extends { href: string }>(list: T[]) => list.filter((l) => usable(l.href));
const mailto = isTodo(contact.email) ? contact.email : `mailto:${contact.email}`;
const cv = { label: 'CV (PDF)', href: `${base}${contact.cv}`, external: false };
const profiles = [
  { label: 'GitHub', href: contact.github, external: true },
  { label: 'LinkedIn', href: contact.linkedin, external: true },
];
const heroLinks = live([...profiles, { label: 'Email', href: mailto, external: false }, cv]);
const contactLinks = live([...profiles, cv]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f5f4f0" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="profile" />
    {[serifUrl, serifItalicUrl, sansUrl, monoUrl].map((u) => <link rel="preload" as="font" type="font/woff2" href={u} crossorigin />)}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      // Runs before first paint: marks JS as available and applies the stored
      // (or system-preferred) theme so the page never flashes the wrong one.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#work">Skip to selected work</a>

    <header class="bar" data-bar>
      <div class="wrap top">
        <a class="top-name" href={base}>{site.name}</a>
        <nav class="top-nav" aria-label="Sections">
          {site.nav.map((n) => <a href={n.href} data-nav>{n.label}</a>)}
        </nav>
        <div class="theme" role="group" aria-label="Colour theme">
          <button type="button" data-theme-set="light" aria-pressed="true">Light</button>
          <span aria-hidden="true">/</span>
          <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <!-- ============================== Hero ============================== -->
      <section class="hero grid">
        <div class="hero-text">
          <h1>{site.name.split(' ').map((part, i) => <>{i > 0 && <br />}{i > 0 ? <em>{part}</em> : part}</>)}</h1>
          <p class="lede">{hero.sentence}</p>
          <p class="interests"><span class="eyebrow">{hero.interestsLabel}</span>{hero.interests}</p>
          <p class="next">{hero.lookingFor}</p>
          <ul class="links">
            {heroLinks.map((l) => <li><Ref {...l} /></li>)}
          </ul>
        </div>
        <div class="hero-fig" id="pipeline">
          <ThesisFlow />
        </div>
      </section>

      <!-- ========================== Selected work ========================= -->
      <section class="section" id="work" data-reveal>
        <h2 set:html={emph(work.heading)} />

        <article class="feature" data-tags={tagAttr(work.featured.tags)}>
          <p class="eyebrow feature-meta"><span class="dates">{work.featured.dates}</span><span>{work.featured.role}</span><span>{work.featured.org}</span></p>
          <h3>{work.featured.title}</h3>
          <p class="outcome">{work.featured.outcome}</p>
          <dl class="details">
            {work.featured.details.filter((d) => usable(d.text)).map((d) => (
              <div>
                <dt class="eyebrow">{d.label}</dt>
                <dd>{isTodo(d.text) ? <span class="todo">{d.text}</span> : d.text}</dd>
              </div>
            ))}
          </dl>
          <div class="feature-foot">
            <Tags tags={work.featured.tags} shared={shared} />
            <ul class="row-links">
              {live(work.featured.links).map((l) => <li><Ref {...l} external /></li>)}
              <li><a href="#pipeline">{work.featured.diagramLink}</a></li>
            </ul>
          </div>
        </article>

        {work.projects.map((p) => (
          <article class="project grid" data-tags={tagAttr(p.tags)}>
            <div class="row-side">
              <p class="dates">{p.dates}</p>
              <p class="eyebrow">{p.role}</p>
              <Tags tags={p.tags} shared={shared} />
            </div>
            <div class="row-main">
              <h3>{p.title}</h3>
              <p class="outcome">{p.outcome}</p>
              {usable(p.result) && (
                <p class="result">
                  <span class="eyebrow">{work.resultLabel}</span>
                  {isTodo(p.result) ? <span class="todo">{p.result}</span> : p.result}
                </p>
              )}
              {live(p.links).length > 0 && (
                <ul class="row-links">
                  {live(p.links).map((l) => <li><Ref {...l} external /></li>)}
                </ul>
              )}
            </div>
          </article>
        ))}

        <div class="more">
          {work.more.items.map((m) => (
            <div class="more-row grid" data-tags={tagAttr(m.tags)}>
              <div class="row-side">
                <p class="eyebrow">{work.more.label}</p>
                <p class="dates">{m.dates}</p>
              </div>
              <div class="row-main">
                <p class="more-text"><b>{m.title}</b>: {m.text}</p>
                <Tags tags={m.tags} shared={shared} />
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== Experience =========================== -->
      <section class="section" id="experience" data-reveal>
        <h2 set:html={emph(experience.heading)} />
        <ol class="timeline">
          {experience.entries.map((e) => (
            <li data-tags={tagAttr(e.tags)}>
              <p class="when dates">{e.dates}</p>
              <div class="what">
                <h3>{e.role}</h3>
                <p class="meta">{e.org}</p>
                <p>{e.text}</p>
                <Tags tags={e.tags} shared={shared} />
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ============ Skills and Education, side by side on desktop ======== -->
      <div class="pair grid">
        <section class="section" id="skills" data-reveal>
          <h2 set:html={emph(skills.heading)} />
          <dl class="skills">
            {skills.groups.map((g) => (
              <div>
                <dt class="eyebrow">{g.label}</dt>
                <dd>{g.text}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="section" id="education" data-reveal>
          <h2 set:html={emph(education.heading)} />
          <div class="edu">
            <div>
              <h3 class="eyebrow">{education.degreesLabel}</h3>
              <ul class="plain">
                {education.degrees.map((d) => (
                  <li>
                    <b>{d.title}</b>
                    <span class="meta">{d.place} <span class="dates">{d.dates}</span></span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="eyebrow">{education.certificatesLabel}</h3>
              <ul class="plain">
                {education.certificates.map((c) => (
                  <li>
                    <b>{c.title}</b>
                    <span class="meta">{c.detail}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="eyebrow">{education.activitiesLabel}</h3>
              <ul class="plain tight">
                {education.activities.map((a) => <li>{a}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="eyebrow">{education.languagesLabel}</h3>
              <ul class="plain langs">
                {education.languages.map((l) => <li>{l.name} <span class="dates">{l.level}</span></li>)}
              </ul>
            </div>
          </div>
        </section>
      </div>

      <!-- ============================= Contact ============================ -->
      <section class="section contact" id="contact" data-reveal>
        <h2 class="eyebrow">{contact.heading}</h2>
        <p class="closing">{contact.closing}</p>
        {usable(contact.email) && (
          <p class="contact-mail">
            {isTodo(contact.email)
              ? <span class="todo">{contact.email}</span>
              : <a href={mailto}>{contact.email}</a>}
          </p>
        )}
        <ul class="links">
          {contactLinks.map((l) => <li><Ref {...l} /></li>)}
        </ul>
      </section>
    </main>

    <footer class="wrap">
      <div class="foot">
        <p>© {year} {site.name}</p>
        <p><a href="#top">Back to top</a></p>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
