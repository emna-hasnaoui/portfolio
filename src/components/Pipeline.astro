---
// Draws a block diagram from a list of stages (see `Stage` in content.ts).
// Two drawings are emitted: a horizontal one for wide screens and a vertical
// one for narrow screens, so labels never shrink below a readable size.
import type { Stage } from '../content';

interface Props {
  stages: Stage[];
  label: string;
}
const { stages, label } = Astro.props;

const LABEL_CH = 6.95; // advance width of the 11.5px mono label
const SUB_CH = 6.05; // advance width of the 10px mono sub-label

function wrap(text: string, max: number): string[] {
  const out: string[] = [];
  let line = '';
  for (const word of text.split(' ')) {
    if (line && (line + ' ' + word).length > max) {
      out.push(line);
      line = word;
    } else {
      line = line ? line + ' ' + word : word;
    }
  }
  if (line) out.push(line);
  return out;
}

function build(dir: 'h' | 'v') {
  const n = stages.length;
  const W = dir === 'h' ? 656 : 300;
  const gap = dir === 'h' ? 26 : 22;
  const bw = dir === 'h' ? (W - 1 - gap * (n - 1)) / n : W - 1;

  const boxes = stages.map((s) => {
    const kind = s.kind ?? 'proc';
    const pad = kind === 'model' ? 13 : 9;
    const L = wrap(s.label, Math.floor((bw - 2 * pad) / LABEL_CH));
    const S = s.sub ? wrap(s.sub, Math.floor((bw - 2 * pad) / SUB_CH)) : [];
    const h = 11 + L.length * 14 + (S.length ? 3 + S.length * 12.5 : 0) + (s.inset ? 27 : 0) + 9;
    return { ...s, kind, pad, L, S, h };
  });

  const uniform = Math.max(...boxes.map((b) => b.h));
  let cursor = 0.5;
  const placed = boxes.map((b, i) => {
    const h = dir === 'h' ? uniform : b.h;
    const x = dir === 'h' ? 0.5 + i * (bw + gap) : 0.5;
    const y = dir === 'h' ? 0.5 : cursor;
    cursor += h + gap;
    return { ...b, x, y, h, w: bw };
  });
  const H = dir === 'h' ? uniform + 1 : cursor - gap + 0.5;

  const arrows = placed.slice(0, -1).map((b, i) => {
    const next = placed[i + 1];
    if (dir === 'h') {
      const y = b.y + b.h / 2;
      const x2 = next.x - 2;
      return { line: `M${b.x + b.w + 3} ${y}H${x2 - 6}`, head: `${x2},${y} ${x2 - 7},${y - 3.5} ${x2 - 7},${y + 3.5}` };
    }
    const x = b.x + b.w / 2;
    const y2 = next.y - 2;
    return { line: `M${x} ${b.y + b.h + 3}V${y2 - 6}`, head: `${x},${y2} ${x - 3.5},${y2 - 7} ${x + 3.5},${y2 - 7}` };
  });

  return { W, H, placed, arrows };
}

const drawings = [
  { dir: 'h', ...build('h') },
  { dir: 'v', ...build('v') },
];
---

{
  drawings.map((d) => (
    <svg class={`pipe pipe-${d.dir}`} viewBox={`0 0 ${d.W} ${d.H}`} width={d.W} height={d.H} role="img" aria-label={label}>
      {d.placed.map((b) => (
        <g>
          {b.kind === 'in' ? (
            <path class="ln" d={`M${b.x} ${b.y}H${b.x + b.w - 10}L${b.x + b.w} ${b.y + 10}V${b.y + b.h}H${b.x}Z M${b.x + b.w - 10} ${b.y}V${b.y + 10}H${b.x + b.w}`} />
          ) : (
            <rect class="ln" x={b.x} y={b.y} width={b.w} height={b.h} />
          )}
          {b.kind === 'model' && <path class="ln" d={`M${b.x + 5} ${b.y}V${b.y + b.h}M${b.x + b.w - 5} ${b.y}V${b.y + b.h}`} />}
          {b.kind === 'out' && <path class="ln" d={`M${b.x} ${b.y + b.h - 4}H${b.x + b.w}`} />}
          {b.L.map((t, i) => (
            <text class:list={['lb', { emph: b.emph }]} x={b.x + b.pad} y={b.y + 20 + i * 14}>{t}</text>
          ))}
          {b.S.map((t, i) => (
            <text class="sb" x={b.x + b.pad} y={b.y + 20 + (b.L.length - 1) * 14 + 16 + i * 12.5}>{t}</text>
          ))}
          {b.inset && (
            <g>
              <rect class="in" x={b.x + b.pad} y={b.y + b.h - 31} width={b.w - 2 * b.pad} height={20} />
              <text class="it" x={b.x + b.pad + 7} y={b.y + b.h - 17.5}>{b.inset}</text>
            </g>
          )}
        </g>
      ))}
      {d.arrows.map((a) => (
        <g>
          <path class="ln" d={a.line} />
          <polygon class="hd" points={a.head} />
        </g>
      ))}
    </svg>
  ))
}
