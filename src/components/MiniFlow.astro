---
// Small three-box diagram for a project row, drawn in the hand-drawn style.
import { box, arrow } from '../lib/sketch';

interface Stage {
  lines: string[];
  accent?: string[];
}
interface Props {
  stages: Stage[];
  label: string;
  seed: number;
}
const { stages, label, seed } = Astro.props;

const W = 330;
const H = 74;
const pad = 5;
const gap = 26;
const n = stages.length;
const bw = (W - 2 * pad - gap * (n - 1)) / n;
const bh = H - 2 * pad;

const boxes = stages.map((s, i) => {
  const x = pad + i * (bw + gap);
  const accent = s.accent ?? [];
  const rows = s.lines.length + accent.length;
  const first = pad + bh / 2 - ((rows - 1) * 14) / 2 + 4;
  return { ...s, accent, x, first };
});
---

<svg class="mini" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={label}>
  {
    boxes.map((b, i) => (
      <g>
        <path class="sk" d={box(seed + i, b.x, pad, bw, bh)} />
        {b.lines.map((t, k) => (
          <text class="mini-l" x={b.x + bw / 2} y={b.first + k * 14} text-anchor="middle">{t}</text>
        ))}
        {b.accent.map((t, k) => (
          <text class="mini-a" x={b.x + bw / 2} y={b.first + (b.lines.length + k) * 14 - 1} text-anchor="middle">{t}</text>
        ))}
        {i < n - 1 && <path class="sk" d={arrow(seed + 50 + i, b.x + bw + 5, H / 2, b.x + bw + gap - 4, H / 2)} />}
      </g>
    ))
  }
</svg>
